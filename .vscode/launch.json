{
    "version": "0.2.0",
    "configurations": [
        // -----------------------------------------------------------------
        // Single DEM
        // -----------------------------------------------------------------
        {
            "name": "Train | Single DEM | CA4D baseline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "args": [
                "--name", "flood-single-ca4d",
                "--use-single-dem",
                "--ca4d",
                "--batch-size", "32"
            ],
            "presentation": {
                "group": "1. Single DEM",
                "order": 1
            }
        },
        {
            "name": "Sample | Single DEM | CA4D baseline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sample.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "args": [
                "--ckpt", "flood-single-ca4d",
                "--use-single-dem",
                "--nfe", "20",
                "--batch-size", "8",
                "--clip-denoise"
            ],
            "presentation": {
                "group": "1. Single DEM",
                "order": 2
            }
        },

